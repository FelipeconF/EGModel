%
%   Replicacion de las Figuras 14 y 15 de
%   Bergoeing, Kehoe, Kehoe y Soto (2002),
%   "A Decade Lost and Found: Mexico and Chile in the 1980s", Review of Economic Dynamics 5, 166-205.
%   Modelo de crecimiento neoclasico con oferta de trabajo endogena,choques exogenos a la PTF y reforma tributaria al capital en 1988.
%   Las series provienen del archivo Decade_Lost_and_Found_Data.xls  

clear all
clc

global alpha beta delta gamma Nbar A tau k0 T

%% ============================================================
%   1. PARAMETROS ESTRUCTURALES (Bergoeing et al. 2002, p. 184-188)

alpha = 0.30;     % participacion del capital
delta = 0.05;     % tasa de depreciacion
beta  = 0.98;     % factor de descuento
Nbar  = 1;        % dotacion de tiempo normalizada

% Pesos del consumo en utilidad (BKKS p. 188)
gamma_MEX = 0.30;
gamma_CHL = 0.28;

% Tasas impositivas al capital
tau_pre  = 0.32;  % pre-1988
tau_post = 0.12;  % post-reforma (BKKS p. 188)

%% ============================================================
%   2. DATOS DEL ARCHIVO Decade_Lost_and_Found_Data.xls
%   Años 1980-2000.

years = (1980:2000)';

% --- Detrended TFP, indice 1980 = 100 ---
% C.39: Mexico (NEW), C.37: Chile (NEW)
A_MEX_data = [100.000000; 101.835582;  96.670811;  88.196692; ...
               86.617371;  84.352079;  78.750676;  76.630348; ...
               73.970805;  73.537589;  73.668613;  72.877339; ...
               71.492767;  69.933099;  70.743926;  64.485541; ...
               64.534577;  64.201295;  64.008832;  63.658386; 65.230737];

A_CHL_data = [100.000000; 100.090244;  83.429491;  78.994228; ...
               80.545556;  80.371816;  79.530626;  80.478250; ...
               80.045087;  83.215534;  81.859546;  85.135794; ...
               89.587416;  89.592623;  91.573987;  98.336179; ...
               98.025900; 100.299816;  98.780750;  96.958052; 98.700700];

% --- Detrended Y/N (working-age, 1980 = 100) ---
% C.14: Mexico, C.13: Chile
YN_MEX_obs = [100.00; 102.75;  96.82;  88.66;  87.03;  84.49;  77.63; ...
               74.94;  72.07;  71.33;  71.23;  70.72;  69.87;  67.95; ...
               67.71;  60.66;  61.06;  62.43;  62.73;  62.42;  63.96];

