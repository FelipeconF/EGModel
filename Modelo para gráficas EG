%% ============================================================
%   7. EXPERIMENTO 4: CHILE - TAX REFORM (reforma en 1988)
%  ============================================================

gamma = gamma_CHL;
A     = [A_CHL_obs; A_CHL_obs(end)*ones(T_extra,1)];
