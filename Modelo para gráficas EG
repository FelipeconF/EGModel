pop_CHL = [6792514; 6942682; 7097010; 7255920; 7419788; 7588940; 7733224; ...
           7882191; 8036026; 8194883; 8358947; 8502825; 8649679; 8797338; ...
           8943120; 9084331; 9236997; 9386888; 9535270; 9684300];
pop_CHL = [pop_CHL; pop_CHL(end)*pop_CHL(end)/pop_CHL(end-1)];

% --- Series construidas a partir de los datos ---
KY_MEX_obs = K_MEX_obs ./ Y_MEX_obs;
KY_CHL_obs = K_CHL_obs ./ Y_CHL_obs;

% L/N: insumo laboral / (poblacion 15-64 * 100). BKKS Apendice A.
LN_MEX_obs = L_MEX_obs ./ (pop_MEX * 100);
LN_CHL_obs = L_CHL_obs ./ (pop_CHL * 100);

% Convertir PTF de indice (1980=100) a niveles relativos a A_1980 = 1
A_MEX_obs = A_MEX_data / 100;
A_CHL_obs = A_CHL_data / 100;

%% ============================================================
%   3. HORIZONTE TEMPORAL
%  ============================================================

T_obs   = length(years);    % 21 periodos observados (1980-2000)
T_extra = 100;              % periodos adicionales para alcanzar el EE
T       = T_obs + T_extra;  % horizonte total

%% ============================================================
%   4. EXPERIMENTO 1: MEXICO - BASE CASE (sin reforma fiscal)
%  ============================================================

gamma = gamma_MEX;
A     = [A_MEX_obs; A_MEX_obs(end)*ones(T_extra,1)];
A     = A.';                            % vector fila 1xT
tau   = tau_pre*ones(1,T);              % impuesto constante

% Estado estacionario inicial (1980, A=1, tau pre-reforma) y terminal
[k0,    c_init, L_init] = compute_ss(1.00, tau_pre, alpha, beta, delta, gamma, Nbar);
[kss_T, css_T,  Lss_T]  = compute_ss(A(end), tau(end), alpha, beta, delta, gamma, Nbar);

% Semilla: interpolacion lineal del EE inicial al EE final
