              106.95; 114.20; 118.27; 122.53; 122.90; 117.28; 119.31];

% --- PIB real, miles de millones de pesos de 1995 ---
% C.2: Mexico, C.1: Chile
Y_MEX_obs = [141463; 153548; 152693; 147407; 152439; 155798; 150941; ...
