kt0 = linspace(k0,     kss_T, T);
Lt0 = linspace(L_init, Lss_T, T);
x0  = [ct0; kt0; Lt0];
x0  = x0(:);                            % vector columna

opts = optimset('Display','off','MaxFunEvals',1e6,'MaxIter',5000, ...
                'TolFun',1e-9,'TolX',1e-9);

[xt_vec, ~, info_MEX_BC] = fsolve(@func_cpo, x0, opts);
