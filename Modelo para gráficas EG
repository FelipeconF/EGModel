[YN_MEX_BC, KY_MEX_BC, LN_MEX_BC] = aggregates(xt_MEX_BC, A, alpha, T_obs);

%% ============================================================
%   5. EXPERIMENTO 2: MEXICO - CON TAX REFORM (reforma 1988)
%  ============================================================

gamma = gamma_MEX;
A     = [A_MEX_obs; A_MEX_obs(end)*ones(T_extra,1)];
A     = A.';
tau   = [tau_pre*ones(1,8), tau_post*ones(1,T-8)];   % 1988 -> t = 9

[k0,    c_init, L_init] = compute_ss(1.00, tau_pre, alpha, beta, delta, gamma, Nbar);
[kss_T, css_T,  Lss_T]  = compute_ss(A(end), tau(end), alpha, beta, delta, gamma, Nbar);

ct0 = linspace(c_init, css_T, T);
kt0 = linspace(k0,     kss_T, T);
Lt0 = linspace(L_init, Lss_T, T);
x0  = [ct0; kt0; Lt0]; x0 = x0(:);

[xt_vec, ~, info_MEX_TR] = fsolve(@func_cpo, x0, opts);
xt_MEX_TR = reshape(xt_vec, 3, T);
[YN_MEX_TR, KY_MEX_TR, LN_MEX_TR] = aggregates(xt_MEX_TR, A, alpha, T_obs);

%% ============================================================
%   6. EXPERIMENTO 3: CHILE - BASE CASE (sin reforma fiscal)
%  ============================================================

gamma = gamma_CHL;
A     = [A_CHL_obs; A_CHL_obs(end)*ones(T_extra,1)];
