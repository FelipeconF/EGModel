%  FUNCIONES LOCALES
%  ============================================================

function err = func_cpo(x_in)
%   Sistema de condiciones de primer orden del modelo neoclasico.

global alpha beta delta gamma Nbar A tau k0 T

x = reshape(x_in, 3, T);
c = x(1,:);
k = x(2,:);
L = x(3,:);

err = zeros(3, T);

for t = 1:T-1
    r_tp1 = alpha     * A(t+1) * k(t+1)^(alpha-1) * L(t+1)^(1-alpha);
    w_t   = (1-alpha) * A(t)   * k(t)^alpha       * L(t)^(-alpha);

    err(1,t) = c(t+1) - beta*(1 + (1-tau(t+1))*(r_tp1 - delta))*c(t);
    err(2,t) = (1-gamma)*c(t) - gamma*(Nbar - L(t))*w_t;
    err(3,t) = c(t) - (A(t)*k(t)^alpha * L(t)^(1-alpha) ...
                      + (1-delta)*k(t) - k(t+1));
end

err(1,T) = k(1)  - k0;
err(2,T) = k(T)  - k(T-1);
err(3,T) = L(T)  - L(T-1);

err = err(:);
end


function [kss, css, Lss] = compute_ss(A_ss, tau_ss, alpha, beta, delta, gamma, Nbar)
%   Estado estacionario del modelo dado A_ss y tau_ss.

kL = ( alpha*A_ss / ( (1/beta - 1)/(1-tau_ss) + delta ) )^(1/(1-alpha));
w  = (1-alpha) * A_ss * kL^alpha;
y_per_L = A_ss * kL^alpha;
c_per_L = y_per_L - delta*kL;

Lss = gamma*w*Nbar / ( (1-gamma)*c_per_L + gamma*w );
kss = kL * Lss;
css = c_per_L * Lss;
end


function [YN, KY, LN] = aggregates(xt, A, alpha, T_obs)
%   Series Y/N (indice 1980=100), K/Y y L/N a partir de la solucion.

c = xt(1, 1:T_obs);
k = xt(2, 1:T_obs);
L = xt(3, 1:T_obs);
A_obs = A(1:T_obs);

Y  = A_obs .* k.^alpha .* L.^(1-alpha);
YN = (Y / Y(1) * 100).';
KY = (k ./ Y).';
LN = L.';
end
